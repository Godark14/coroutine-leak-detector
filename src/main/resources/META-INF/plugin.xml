<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.godark14.coroutineleakdetector</id>
    <name>Coroutine Leak Detector</name>
    <vendor email="kgodwinagbe@gmail.com" url="https://github.com/godark14">godark14</vendor>
    <description><![CDATA[
    <p><b>Coroutine Leak Detector</b> analyzes Kotlin code in Android projects to catch common coroutine and Flow lifecycle mistakes before they cause memory leaks or crashes in production.</p>
    <p>Currently detects:</p>
    <ul>
        <li><b>GlobalScope misuse</b> — coroutines launched with <code>GlobalScope</code> are never automatically cancelled and can leak.</li>
        <li><b>Unsafe Flow collection</b> — collecting a <code>Flow</code> without <code>repeatOnLifecycle</code> or <code>flowWithLifecycle</code> can run outside the intended lifecycle.</li>
    </ul>
    <p>Each detection comes with a clear explanation and, where possible, a quick fix to guide the migration.</p>
]]></description>
    <change-notes><![CDATA[
    See the full changelog on GitHub.
]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
            language="kotlin"
            shortName="GlobalScopeUsage"
            displayName="GlobalScope usage in coroutines"
            groupDisplayName="Coroutine Leak Detector"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.github.godark14.coroutineleakdetector.inspections.GlobalScopeInspection"/>
        <localInspection
            language="kotlin"
            shortName="FlowCollectWithoutLifecycle"
            displayName="Flow collection without lifecycle awareness"
            groupDisplayName="Coroutine Leak Detector"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.github.godark14.coroutineleakdetector.inspections.FlowCollectWithoutLifecycleInspection"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>